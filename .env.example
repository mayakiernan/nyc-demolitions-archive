# Use file:./data/nyc-demolition.db locally. Use a libsql:// URL in Vercel.
TURSO_DATABASE_URL=file:./data/nyc-demolition.db
TURSO_AUTH_TOKEN=
# Local default: /maps/nyc.pmtiles. Leave unset while testing locally.
# Set only when moving the archive to a public static host later.
NEXT_PUBLIC_MAP_ARCHIVE_URL=
LLM_PROVIDER=rule-based # rule-based | openai | claude
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: activates CC-BY-SA Mapillary candidate discovery in the image pilot.
MAPILLARY_ACCESS_TOKEN=
ADMIN_ACCESS_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-second-long-random-secret
# Future review-inbox destination. Email sending is not enabled until a provider is configured.
SUBMISSION_REVIEW_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
